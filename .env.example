# AutoRepair AI Environment Configuration

# 1. Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=autorepair
DATABASE_URL=postgresql+asyncpg://postgres:supersecret@localhost:5432/autorepair

# 2. Security
# Run `openssl rand -hex 32` to generate a secure secret
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# 3. Third-Party Integrations
# OPENAI_API_KEY=sk-xxxx
# GOOGLE_MAPS_API_KEY=AIzaSyBxxxx
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx
# AWS_S3_BUCKET_NAME=autorepair-uploads

# 4. API Configuration
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000", "https://autorepair.ai"]
